# Copy to .env — never commit the real file.

# --- API (FastAPI on port 8085) ---
DATABASE_URL=sqlite:///./data/nexusone.db
REDIS_URL=redis://localhost:6379/0
REDIS_OPTIONAL=true
SECRET_KEY=replace-with-a-long-random-secret-at-least-32
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:3005
APP_SEED_PASSWORD=ChangeMe123!
SEED_DEMO_DATA=true
WORKER_INTERVAL_SECONDS=20

# --- Frontend (Next.js on port 3005) ---
NEXT_PUBLIC_API_URL=http://localhost:8085/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8085/ws/incidents
